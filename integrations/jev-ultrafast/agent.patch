@@ -0,0 +1,73 @@
+"""Offline contract for the local xiaojev backend. No paid APIs, no browser.
+
+Skips unless torch + CUDA + a local checkpoint are available; the model call
+runs on GPU. Default behavior (remote TypeSafe path) is not exercised here.
+"""
+
+import os
+from pathlib import Path
+
+import pytest
+
+from jev_ultrafast import local_model
+
+pytestmark = pytest.mark.skipif(
+    not os.environ.get("XIAOJEV_CKPT")
+    and not (Path(local_model._HOME) / "ckpt/v4_browser/manifest.json").is_file(),
+    reason="no local xiaojev checkpoint",
+)
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("no CUDA device", allow_module_level=True)
+
+from jev_ultrafast import local_model, model  # noqa: E402
+
+
+def page():
+    return {
+        "url": "https://example.test/",
+        "title": "Search",
+        "text": "Search",
+        "actions": [
+            {"id": "e1", "kind": "fill", "label": "Search", "role": "textbox", "value": "", "node": 10},
+            {"id": "e2", "kind": "click", "label": "Open Search", "role": "textbox", "value": "", "node": 10},
+            {"id": "e3", "kind": "click", "label": "Go", "role": "button", "value": "", "node": 20},
+            {"id": "wait", "kind": "wait", "label": "Wait"},
+        ],
+    }
+
+
+def test_answer_shape_and_validation():
+    elements, targets, controls = model.action_space(page()["actions"])
+    body = {
+        "model": "local",
+        "state": {"page": {"url": "u", "title": "t", "text": "x"}, "elements": elements, "recent_actions": []},
+        "questions": {
+            "operation": {"type": "choice",
+                          "criteria": {"CLICK": "Click.", "TYPE_TEXT": "Type.", "DONE": "Done.", "BLOCKED": "Blocked."},
+                          "instructions": {"goal": "Find a book", "rules": "Pick one."}},
+            "click_target": {"type": "choice",
+                             "criteria": {"1": {"element": "[1] Search"}, "2": {"element": "[2] Go"}},
+                             "instructions": {"goal": "Find a book", "operation": "CLICK"}},
+        },
+    }
+    result = local_model.answer(body)
+    assert set(result["answers"]) == {"operation", "click_target"}
+    for qid, criteria in (("operation", body["questions"]["operation"]["criteria"]),
+                          ("click_target", body["questions"]["click_target"]["criteria"])):
+        model.validate_choice(result["answers"][qid], criteria)
+    assert result["usage"]["autoregressive_decode_steps"] == 0
+    assert result["usage"]["forward_passes"] == 1
+
+
+def test_choose_end_to_end_local(monkeypatch):
+    monkeypatch.setenv("JEV_BACKEND", "local")
+    monkeypatch.delenv("TYPESAFE_API_KEY", raising=False)  # local path must not need the key
+    d = model.choose(page(), "Find a book", [])
+    assert d["choice"] in {"e1", "e2", "e3", "wait", "DONE", "BLOCKED"}
+    assert d["operation"] in {"CLICK", "TYPE_TEXT", "WAIT", "DONE", "BLOCKED"}
+    assert set(d["raw_answers"]) == {"operation", "click_target", "type_text_target"}
+    assert 0 <= d["confidence"] <= 1
+    if d["target_probabilities"]:
+        assert abs(sum(d["target_probabilities"].values()) - 1) < 0.02
+    assert d["usage"]["autoregressive_decode_steps"] == 0
