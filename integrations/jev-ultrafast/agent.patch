@@ -0,0 +1,44 @@
+from copy import deepcopy
+
+from jev_ultrafast.agent import progress_signature
+from jev_ultrafast.local_model import _state_text, question_row
+
+
+def test_visible_control_state_and_history_survive_serialization():
+    state = {
+        "page": {"title": "Search", "url": "https://example.test/", "text": "Results"},
+        "elements": [
+            {"index": "1", "label": "Accessible", "role": "checkbox", "operations": ["CLICK"],
+             "checked": False, "value": "on"},
+            {"index": "2", "label": "Category", "role": "combobox", "operations": ["SELECT"],
+             "value": "Any", "options": [{"index": "2:1", "label": "Category → Nature", "value": "Nature"}]},
+        ],
+        "recent_actions": [{"kind": "fill", "action": "Destination", "text": "Bergen", "progressed": False}],
+    }
+    text = _state_text(state)
+    assert "checked=false" in text
+    assert "Nature" in text and "2:1" in text
+    assert '"text": "Bergen"' in text and '"progressed": false' in text
+    changed = deepcopy(state)
+    changed["elements"][0]["checked"] = True
+    assert text != _state_text(changed)
+
+
+def test_candidate_false_state_and_rules_are_not_discarded():
+    row = question_row({"page": {}, "elements": []}, {
+        "criteria": {"1": {"element": "[1] Accessible", "role": "checkbox", "checked": False}},
+        "instructions": {"goal": "Find a place", "operation": "CLICK", "rules": ["First rule.", "Second rule."]},
+    })
+    assert "checked=false" in row["candidates"][0]
+    assert "First rule.\n\nSecond rule." in row["instruction"]
+
+
+def test_dom_replacement_is_not_task_progress_but_control_changes_are():
+    before = {"url": "https://example.test/", "title": "Search", "text": "Results", "fingerprint": "old",
+              "actions": [{"id": "e1", "node": 3, "kind": "click", "label": "Filter", "checked": "false"}]}
+    after = deepcopy(before)
+    after["fingerprint"] = "new"
+    after["actions"][0].update(id="e2", node=91)
+    assert progress_signature(before) == progress_signature(after)
+    after["actions"][0]["checked"] = "true"
+    assert progress_signature(before) != progress_signature(after)
